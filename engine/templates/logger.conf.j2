[general]
; Asterisk only rotates on an explicit `logger rotate` / `logger reload`; the entrypoint's
; size watchdog drives that. This just picks the naming strategy it uses when it does.
rotatestrategy = rotate

[logfiles]
console => notice,warning,error,verbose{{ ',debug' if debug_asterisk else '' }}
full => notice,warning,error,verbose,dtmf{{ ',debug' if debug_asterisk else '' }}
messages => notice,warning,error
